<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sahayak_surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMapPickerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Select Sangha Location on Map"
            android:textColor="@color/sahayak_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins"
            android:text="Search place name, paste Google Maps link, or detect live GPS:"
            android:textColor="@color/sahayak_text_secondary"
            android:textSize="12sp" />

        <!-- Search Place / Address Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMapSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search Area / City / LandMark"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/sahayak_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMapSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:inputType="textCapWords"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchMapPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/sahayak_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Google Maps Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E2ECE9"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/sahayak_primary"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.4"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_map"
                    app:tint="@color/sahayak_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/status_rejected" />

                    <TextView
                        android:id="@+id/tvPickedPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="No Location Selected Yet (Use Search or GPS below)"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/poppins"
                    android:text="Google Maps Location Selector"
                    android:textColor="@color/sahayak_text_secondary"
                    android:textSize="10sp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Textbox to Paste Copied Google Maps Location Link -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPasteLink"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Paste Copied Google Maps Link / Location Here *"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:startIconDrawable="@drawable/ic_edit"
            app:startIconTint="@color/sahayak_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasteLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:inputType="textUri"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Detect Current GPS Location Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetectCurrentLocation"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="Detect Current GPS Location (High Accuracy)"
            android:textAllCaps="false"
            android:textColor="@color/sahayak_primary"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_location"
            app:iconTint="@color/sahayak_primary" />

        <!-- Open in Google Maps App Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenGoogleMapsApp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="Open Place in Google Maps App"
            android:textAllCaps="false"
            android:textColor="@color/sahayak_primary"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_map"
            app:iconTint="@color/sahayak_primary"
            app:strokeColor="@color/sahayak_primary" />

        <!-- Confirm and Cancel Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:text="Confirm &amp; Fill Address"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@color/sahayak_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
