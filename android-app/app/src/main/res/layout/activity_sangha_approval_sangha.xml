<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sahayak_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Banner Header -->
        <LinearLayout
            android:id="@+id/layoutStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/status_verification"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clock"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvStatusHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="Registration Under Review"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tvApprovalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_banner"
                android:fontFamily="@font/poppins"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="PENDING APPROVAL"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Card Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-24dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/sahayak_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Organization Details"
                    android:textColor="@color/sahayak_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSanghaName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:text="Karuna Social Support &amp; Care Sangha"
                    android:textColor="@color/sahayak_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRegNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:text="Reg No: REG-SNG-2022-109"
                    android:textColor="@color/sahayak_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:text="Contact: +91 9899887766 | karuna@sahayak.org"
                    android:textColor="@color/sahayak_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:text="Address: Kodialbail, Mangaluru"
                    android:textColor="@color/sahayak_text_secondary"
                    android:textSize="13sp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider_color" />

                <!-- Rejection Notice Banner (Shown when rejected) -->
                <LinearLayout
                    android:id="@+id/layoutRejectionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_circle_accent_light"
                    android:backgroundTint="#FFEBEE"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Reason for Non-Approval"
                        android:textColor="@color/status_rejected"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRejectionReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="2dp"
                        android:text="Official registration documentation was unverified."
                        android:textColor="#C62828"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Pending Status Notice -->
                <LinearLayout
                    android:id="@+id/layoutPendingNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Verification Process"
                        android:textColor="@color/sahayak_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins"
                        android:lineSpacingExtra="3dp"
                        android:text="Your NGO registration application is currently under verification by the Sahayak Central Trust administration.\n\nOnce verified, your organization will be unlocked to receive ground verification assignments, deliver aid packages, and accept community sponsorships."
                        android:textColor="@color/sahayak_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Simulation Action Button (For Demo / Testing) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateApprove"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins"
                    android:text="[Demo] Simulate Admin Approval"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_completed"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_check_circle"
                    app:iconGravity="textStart" />

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins"
                    android:text="Logout Account"
                    android:textAllCaps="false"
                    android:textColor="@color/status_rejected"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="@color/status_rejected"
                    app:strokeColor="@color/status_rejected" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

